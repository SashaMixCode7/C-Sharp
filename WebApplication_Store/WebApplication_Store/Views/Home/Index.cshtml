<!--WebApplication_Store.Models.Goods>-->

@using WebApplication_Store.Services

@model IEnumerable<WebApplication_Store.Models.Goods>

    <script type="text/javascript">
        var Goods = {};
        JSON.parse('@Json.Serialize(@Model)').forEach((item, index, array) =>{
            Goods[item["id"]] = item;
        });

    </script>


<div class="container">
        <div class="col-8"></div>
        <div class="col-4 calum" id="fool">
        <div class="info-block menu-name">
            <div class="menu-logo">
                <img src="~/Files/logo.jpg" alt="Логотип" style="max-width: 100px;">
            </div>
            Кремовый вкус
        </div>
            <div class="container" id="fool">
                @Html.CreateImage(Model)
            </div>
        </div>
        <div class="cart-section col-4">
            <div class="info-block">🛒 Корзина</div>
            <div id="order_sheet">

                <!--<div id="id_goods_4">
                    <div>name</div>
                    <div>count+1</div>
                    <div>price+price</div>
                </div>-->
                <table id="table_order">
                    <tr>
                        <td>Name</td>
                        <td>Price</td>
                        <td>Count</td>
                    </tr>
                </table>
                <div class="info-block">
                    <p>Итого: </p>
                    <div id="summa"></div>
                </div>
            </div>

            <div class="btn_t telegram-btn" onclick="Buy_Goods()"> Заказ </div>
        </div>
    </div>